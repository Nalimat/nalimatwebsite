# Copy to .env.local for local use. In production, set these in the hosting
# dashboard (Vercel: Project > Settings > Environment Variables), never in git.

# Where contact form enquiries are sent (JSON POST). Any webhook works:
# an email service, CRM, Slack, Zapier, Make or n8n endpoint.
# Required in production; in development enquiries are logged to the console.
# Server-only: never sent to the browser.
CONTACT_WEBHOOK_URL=

# Google Analytics 4 measurement ID, e.g. G-ABC123XYZ9
# (GA4 > Admin > Data streams > your web stream > Measurement ID).
# Optional: analytics is off when empty. Read at BUILD time, so redeploy after
# changing it. Not a secret: GA4 IDs are always visible in a site's page source.
VITE_GA_MEASUREMENT_ID=

# "true" sends events to GA4 DebugView and turns analytics on in `npm run dev`.
# Leave empty in production.
VITE_GA_DEBUG=

# Google Search Console HTML-tag verification: only the content="..." value of
# the tag Search Console shows you. Optional: leave empty if you verify with a
# DNS TXT record (recommended). Read at BUILD time.
GOOGLE_SITE_VERIFICATION=
