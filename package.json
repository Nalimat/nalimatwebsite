{
  "name": "nalimat-web",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "postbuild": "node scripts/check-build-output.mjs",
    "preview": "vite preview",
    "lint": "eslint",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check:placeholders": "node scripts/check-placeholders.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "framer-motion": "^14.14.0",
    "lucide-react": "1.80.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "^8.5.3"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8"
  }
}
